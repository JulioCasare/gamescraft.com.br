# Public ports exposed by the Velocity proxy
JAVA_PORT=25565
BEDROCK_PORT=19132

# Versao por modo, presa a compatibilidade dos plugins de cada um.
# 26.2 nos modos gerais para a lanca (adicionada na 1.21.9) existir no PvP e
# nos eventos. O BedWars fica na 1.21.4 porque o BedWars1058 25.2 (ultima
# versao oficial) suporta ate ela; o ViaVersion nesse backend deixa clientes
# mais novos entrarem. Suba versao somente depois de testar plugins e mapas.
MINECRAFT_VERSION=26.2
MINECRAFT_VERSION_BEDWARS=1.21.4

# Replace PUBLIC_HOST when the server receives its real domain or public IP.
PUBLIC_HOST=localhost

# TRUE mantem o beta fechado: so entra quem esta na whitelist de cada servidor.
# Trocar para FALSE e o ato de abrir ao publico. Antes disso, leia a secao
# "Como saber que o beta acabou" em docs/BETA-CHECKLIST.md.
BETA_WHITELIST=TRUE

# Java heap per service. The sum of these values is what Docker actually needs,
# plus roughly 1 GB for MariaDB and the container overhead itself.
# Defaults below total about 11.5 GB and target a 16 GB Docker allocation.
# Raise them only after `spark` shows a real shortage during load tests.
MEMORY_PROXY=1G
MEMORY_LOBBY=1500M
MEMORY_BEDWARS=2500M
MEMORY_PILLARS=1500M
MEMORY_BUILDBATTLE=1500M
MEMORY_CTF=1500M
MEMORY_PVP=1500M
# Servidor de eventos: sobe so no dia. Precisa de mais folga porque operacoes
# grandes de WorldEdit consomem bastante memoria de uma vez.
MEMORY_EVENTOS=2G

# Generated by scripts/prepare-beta.ps1. Do not commit real values.
VELOCITY_SECRET=REPLACE_ME
DATABASE_NAME=gamecraft
DATABASE_USER=gamecraft
DATABASE_PASSWORD=REPLACE_ME
DATABASE_ROOT_PASSWORD=REPLACE_ME
